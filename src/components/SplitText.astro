---
// Renders text letter-by-letter so it can animate in when its parent gets `.is-visible`.
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
let i = 0;
const words = text.split(" ").map((word) => [...word].map((char) => ({ char, i: i++ })));
---

<span class={className} aria-label={text}>
  {
    words.map((letters, w) => (
      <>
        <span class="inline-block whitespace-nowrap" aria-hidden="true">
          {letters.map(({ char, i }) => (
            <span class="split-letter" style={`--i: ${i}`}>
              {char}
            </span>
          ))}
        </span>
        {w < words.length - 1 && " "}
      </>
    ))
  }
</span>
