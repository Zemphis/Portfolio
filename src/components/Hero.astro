---
import { siteConfig } from "../config";
import SplitText from "./SplitText.astro";

const [firstName, ...rest] = siteConfig.name.split(" ");
const lastName = rest.join(" ");

const study = siteConfig.title.replace(/^Bachelor of /i, "");

const current = siteConfig.experience?.find((exp) => /present/i.test(exp.dateRange));
const previous = siteConfig.experience?.find((exp) => exp !== current);

const socials = [
  siteConfig.social?.email && {
    label: "Email",
    href: `mailto:${siteConfig.social.email}`,
    paths: [
      "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
      "M3 7l9 6l9 -6",
    ],
  },
  siteConfig.social?.linkedin && {
    label: "LinkedIn",
    href: siteConfig.social.linkedin,
    paths: [
      "M8 11v5",
      "M8 8v.01",
      "M12 16v-5",
      "M16 16v-3a2 2 0 1 0 -4 0",
      "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
    ],
  },
  siteConfig.social?.github && {
    label: "GitHub",
    href: siteConfig.social.github,
    paths: [
      "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
    ],
  },
].filter(Boolean) as { label: string; href: string; paths: string[] }[];
---

<section
  id="hero"
  class="relative isolate flex min-h-svh flex-col overflow-hidden px-5 pt-24 pb-10 sm:px-8 md:px-12"
>
  {
    siteConfig.heroBackground ? (
      <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <img
          src={siteConfig.heroBackground}
          alt=""
          fetchpriority="high"
          class="h-full w-full scale-110 object-cover blur-md brightness-[1.35] saturate-[1.25]"
        />
        <div class="absolute inset-0 bg-ink/35" />
        <div class="absolute inset-0 bg-gradient-to-b from-ink/40 via-transparent via-60% to-ink" />
      </div>
    ) : (
      <div
        class="absolute inset-0 -z-10"
        style="background: radial-gradient(ellipse 70% 60% at 85% 20%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 70%), radial-gradient(ellipse 50% 50% at 0% 100%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 70%);"
      />
    )
  }

  <!-- VHS on-screen display -->
  <div
    class="mx-auto flex w-full max-w-[1400px] items-center justify-between font-mono text-xs uppercase tracking-[0.2em] text-paper/70 sm:text-sm"
    aria-hidden="true"
  >
    <span>▶ Play</span>
    <span class="flex items-center gap-2">
      <span class="blink inline-block h-2.5 w-2.5 rounded-full bg-accent"></span>
      Rec <span id="timecode" class="tabular-nums">00:00:00:00</span>
    </span>
  </div>

  <div
    class="mx-auto grid w-full max-w-[1400px] flex-1 grid-cols-1 items-center gap-12 py-12 lg:grid-cols-12"
  >
    <div class="lg:col-span-8" data-reveal>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted sm:text-sm">
        my name is
      </p>
      <h1
        class="chroma mt-4 text-[17vw] font-semibold leading-[0.85] tracking-[-0.06em] sm:text-[14vw] lg:text-[10.5vw] 2xl:text-[150px]"
      >
        <SplitText text={firstName} />
        <span class="block font-serif font-normal italic tracking-[-0.03em] text-accent">
          {lastName}
        </span>
      </h1>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          siteConfig.availability && (
            <span class="inline-flex items-center gap-2 rounded-full border border-paper/15 bg-paper/5 px-4 py-2 font-mono text-xs uppercase tracking-[0.15em] backdrop-blur">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400" />
              </span>
              {siteConfig.availability}
            </span>
          )
        }
        <div class="font-mono text-xs uppercase leading-relaxed tracking-[0.12em] text-muted">
          {current && <p>Currently at <span class="text-paper">{current.company}</span></p>}
          {previous && <p>Previously at <span class="text-paper">{previous.company}</span></p>}
        </div>
      </div>
    </div>

    <div class="relative mx-auto w-56 sm:w-64 lg:col-span-4 lg:w-full lg:max-w-sm" data-reveal style="--reveal-delay: 200ms">
      <div
        class="group relative rotate-[3deg] overflow-hidden rounded-[28px] border border-paper/10 bg-ink-2 p-2 shadow-2xl shadow-black/60 transition-transform duration-500 hover:rotate-0"
      >
        <img
          src={siteConfig.image}
          alt={siteConfig.name}
          class="aspect-[4/5] w-full rounded-[22px] object-cover grayscale-[30%] sepia-[15%] transition-all duration-500 group-hover:grayscale-0 group-hover:sepia-0"
        />
        <div
          class="pointer-events-none absolute inset-2 flex flex-col justify-between rounded-[22px] p-4 font-mono text-[10px] uppercase tracking-[0.2em] text-white/80"
        >
          <span>Tape 01</span>
          <span class="self-end">SP ▸ {new Date().getFullYear()}</span>
        </div>
      </div>
      <span
        class="absolute -top-10 -left-6 rotate-[-10deg] font-hand text-3xl text-accent-soft sm:-left-12"
      >
        that's me!
        <svg class="ml-6 inline-block h-8 w-10 rotate-[30deg]" viewBox="0 0 40 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M2 4 C 14 2, 30 8, 34 24" />
          <path d="M26 20 L34 25 L37 16" />
        </svg>
      </span>
    </div>
  </div>

  <div
    class="mx-auto flex w-full max-w-[1400px] flex-col gap-8 border-t border-paper/10 pt-8 md:flex-row md:items-end md:justify-between"
    data-reveal
    style="--reveal-delay: 350ms"
  >
    <p class="max-w-xl text-2xl leading-tight tracking-[-0.03em] text-paper/90 sm:text-3xl">
      {study} student in {siteConfig.location} who loves to
      <span class="font-serif italic text-accent"> figure out how things work</span>.
    </p>

    <div class="flex flex-wrap items-center gap-3">
      {
        siteConfig.social?.email && (
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="rounded-full bg-accent px-6 py-3 font-mono text-xs font-medium uppercase tracking-[0.15em] text-ink transition-transform duration-300 hover:-translate-y-0.5"
          >
            Email me ↗
          </a>
        )
      }
      <a
        href="/Fardeen Rahman Resume.pdf"
        download="Fardeen Rahman Resume.pdf"
        class="rounded-full border border-paper/20 px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] transition-colors duration-300 hover:border-accent hover:text-accent"
      >
        Resume ↓
      </a>
      <div class="flex items-center gap-1 pl-2">
        {
          socials
            .filter((s) => s.label !== "Email")
            .map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-paper/15 transition-colors duration-300 hover:border-accent hover:text-accent"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  {social.paths.map((d) => <path d={d} />)}
                </svg>
              </a>
            ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // VHS-style timecode: HH:MM:SS:FF since the tape started
  const el = document.getElementById("timecode");
  const start = performance.now();
  const pad = (n: number) => String(n).padStart(2, "0");
  const update = () => {
    const elapsed = performance.now() - start;
    const frames = Math.floor((elapsed / 1000) * 30) % 30;
    const total = Math.floor(elapsed / 1000);
    if (el) {
      el.textContent = `${pad(Math.floor(total / 3600))}:${pad(Math.floor(total / 60) % 60)}:${pad(total % 60)}:${pad(frames)}`;
    }
    requestAnimationFrame(update);
  };
  requestAnimationFrame(update);
</script>
