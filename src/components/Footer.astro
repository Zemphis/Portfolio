---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const links = [
  { href: "#about", label: "About", show: true },
  { href: "#projects", label: "Works", show: hasProjects },
  { href: "#experience", label: "Experience", show: hasExperience },
  { href: "#education", label: "Education", show: hasEducation },
].filter((link) => link.show);

const socials = [
  { label: "Email", href: siteConfig.social?.email && `mailto:${siteConfig.social.email}` },
  { label: "LinkedIn", href: siteConfig.social?.linkedin },
  { label: "GitHub", href: siteConfig.social?.github },
].filter((social) => social.href);
---

<footer class="relative overflow-hidden border-t border-paper/10 bg-ink-2 px-5 pt-24 sm:px-8 md:px-12">
  <div class="mx-auto max-w-[1400px]">
    <!-- Call to action -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-8">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">(06) — say hello</p>
        <h2 class="mt-6 text-5xl font-semibold leading-[0.95] tracking-[-0.05em] sm:text-6xl md:text-7xl">
          Got a challenge
          <span class="font-serif font-normal italic text-accent"> for me?</span>
        </h2>
        {
          siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="mt-10 inline-flex items-center gap-3 rounded-full bg-accent px-7 py-4 font-mono text-sm font-medium uppercase tracking-[0.15em] text-ink transition-transform duration-300 hover:-translate-y-0.5"
            >
              {siteConfig.social.email} ↗
            </a>
          )
        }
      </div>

      <div class="grid grid-cols-2 gap-8 font-mono text-xs uppercase tracking-[0.15em] lg:col-span-4">
        <div>
          <p class="mb-4 text-muted">Navigate</p>
          <ul class="space-y-3">
            {links.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-accent">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-4 text-muted">Elsewhere</p>
          <ul class="space-y-3">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.label === "Email" ? undefined : "_blank"}
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-accent"
                >
                  {social.label} ↗
                </a>
              </li>
            ))}
            <li>
              <a
                href="/Fardeen Rahman Resume.pdf"
                download="Fardeen Rahman Resume.pdf"
                class="transition-colors hover:text-accent"
              >
                Resume ↓
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-20 flex flex-col gap-3 border-t border-paper/10 pt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <span>{siteConfig.location} · <span data-clock>--:--:--</span></span>
      <a href="#hero" class="transition-colors hover:text-accent">⏏ Rewind to top</a>
    </div>
  </div>

  <!-- Giant VHS-style name -->
  <p
    class="pointer-events-none mt-6 -mb-[0.18em] select-none whitespace-nowrap text-center text-[15.5vw] font-semibold leading-none tracking-[-0.07em] text-paper/[0.06]"
    aria-hidden="true"
  >
    {siteConfig.name.split(" ")[0]}<span class="font-serif font-normal italic tracking-[-0.03em]"
      >{siteConfig.name.split(" ").slice(1).join(" ")}</span
    >
  </p>
</footer>
