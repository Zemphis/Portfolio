---
import { siteConfig } from "../config";

const items = siteConfig.skills ?? [];
---

{
  items.length > 0 && (
    <div
      class="relative overflow-hidden border-y border-paper/10 bg-ink-2 py-5"
      aria-label={`Skills: ${items.join(", ")}`}
    >
      <div class="marquee-track" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {items.map((skill, i) => (
              <>
                <span
                  class={`px-6 text-3xl tracking-[-0.03em] sm:text-4xl ${
                    i % 2 === 0 ? "font-semibold uppercase" : "font-serif italic text-accent"
                  }`}
                >
                  {skill}
                </span>
                <span class="text-xl text-paper/30">✦</span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  )
}
