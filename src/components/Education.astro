---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="px-5 py-24 sm:px-8 md:px-12 md:py-36">
      <div class="mx-auto max-w-[1400px]">
        <SectionHeading index="05" label="where I've studied" title="Education" serif=" so far" />

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
          {siteConfig.education.map((edu, index) => (
            <article
              data-reveal
              style={`--reveal-delay: ${index * 120}ms`}
              class="flex flex-col rounded-[32px] border border-paper/10 bg-ink-2 p-6 transition-colors duration-500 hover:border-accent/50 sm:p-8 md:p-10"
            >
              <div class="flex items-center justify-between font-mono text-xs uppercase tracking-[0.15em] text-muted">
                <span class="text-accent">{edu.dateRange}</span>
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="mt-6 text-3xl font-semibold leading-[1.05] tracking-[-0.04em] sm:text-4xl">
                {edu.school}
              </h3>
              <p class="mt-2 font-serif text-xl italic text-paper/70">{edu.degree}</p>

              <ul class="mt-8 space-y-3 border-t border-paper/10 pt-6">
                {edu.achievements.map((achievement) => (
                  <li class="flex gap-3 text-base leading-relaxed text-paper/65">
                    <span class="mt-1 font-mono text-xs text-accent">✦</span>
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
