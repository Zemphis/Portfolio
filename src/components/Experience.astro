---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="px-5 py-24 sm:px-8 md:px-12 md:py-36">
      <div class="mx-auto max-w-[1400px]">
        <SectionHeading index="04" label="where I've worked" title="Experience" serif=" log" />

        <ol class="border-t border-paper/10">
          {siteConfig.experience.map((exp, index) => (
            <li
              data-reveal
              class="group grid grid-cols-1 gap-4 border-b border-paper/10 py-10 transition-colors duration-500 hover:bg-paper/[0.02] md:grid-cols-12 md:gap-10"
            >
              <span class="font-serif text-5xl italic leading-none text-paper/25 transition-colors duration-500 group-hover:text-accent md:col-span-1">
                {index + 1}
              </span>
              <div class="md:col-span-4">
                <h3 class="text-2xl font-semibold leading-tight tracking-[-0.03em] sm:text-3xl">
                  {exp.title}
                </h3>
                <p class="mt-2 font-serif text-xl italic text-accent">{exp.company}</p>
                <p class="mt-3 font-mono text-xs uppercase tracking-[0.15em] text-muted">
                  {exp.dateRange}
                </p>
              </div>
              <ul class="space-y-3 md:col-span-7">
                {exp.bullets.map((bullet) => (
                  <li class="flex gap-3 text-base leading-relaxed text-paper/65 sm:text-lg">
                    <span class="mt-1 font-mono text-xs text-accent">→</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
