---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const pad = (n: number) => String(n).padStart(2, "0");
---

{
  hasProjects && (
    <section id="projects" class="px-5 py-24 sm:px-8 md:px-12 md:py-36">
      <div class="mx-auto max-w-[1400px]">
        <SectionHeading index="03" label="what I have made" title="Featured" serif=" works" note="explore my work!" />

        <div class="space-y-5">
          {siteConfig.projects.map((project, index) => {
            const Component = project.link ? "a" : "div";
            const linkProps = project.link
              ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
              : {};

            return (
              <Component
                {...linkProps}
                data-reveal
                class="group relative block overflow-hidden rounded-[32px] border border-paper/10 bg-ink-2 p-6 transition-colors duration-500 hover:border-accent/50 sm:p-8 md:p-10"
              >
                {/* Big VHS-style index number */}
                <span
                  class="pointer-events-none absolute -right-2 -bottom-10 font-serif text-[9rem] leading-none italic text-paper/[0.04] transition-colors duration-500 group-hover:text-accent/15 md:text-[14rem]"
                  aria-hidden="true"
                >
                  {pad(index + 1)}
                </span>

                <div class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
                  <div class="md:col-span-7">
                    <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.18em] text-muted">
                      <span class="text-accent">project {pad(index + 1)}</span>
                      <span class="h-px w-8 bg-paper/20" />
                      <span>{project.skills?.[0]}</span>
                    </div>
                    <h3 class="mt-4 text-3xl font-semibold leading-[1] tracking-[-0.04em] sm:text-4xl md:text-5xl">
                      {project.name}
                    </h3>
                  </div>

                  <div class="flex flex-col gap-6 md:col-span-5">
                    <p class="text-base leading-relaxed text-paper/60 sm:text-lg">
                      {project.description}
                    </p>

                    {project.skills && project.skills.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {project.skills.map((skill) => (
                          <span class="rounded-full bg-paper/5 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-paper/70">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}

                    {project.link && (
                      <span class="inline-flex w-fit items-center gap-2 rounded-full border border-paper/20 px-5 py-2.5 font-mono text-xs uppercase tracking-[0.15em] transition-all duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-ink">
                        View project
                        <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                        </svg>
                      </span>
                    )}
                  </div>
                </div>
              </Component>
            );
          })}
        </div>
      </div>
    </section>
  )
}
