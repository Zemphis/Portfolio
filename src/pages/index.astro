---
import Analytics from '@vercel/analytics/astro';
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Gallery from "../components/Gallery.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html
  lang="en"
  data-theme="dark"
  style={`--accent-dark: ${siteConfig.accentColor}; --accent-light: ${siteConfig.accentColorLight}`}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f0f0f" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "light" ? "#f7f9fd" : "#0f0f0f");
        }
      } catch {}
    </script>
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@300..800&family=Just+Me+Again+Down+Here&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>
  </head>
  <body>
    <div class="vhs-vignette" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-60 overflow-hidden" aria-hidden="true">
      <div class="vhs-grain"></div>
    </div>
    <div class="vhs-scanlines" aria-hidden="true"></div>
    <div class="vhs-tracking" aria-hidden="true"></div>

    <Header />
    <main>
      <Hero />
      <Marquee />
      <About />
      <Gallery />
      <Projects />
      <Experience />
      <Education />
    </main>
    <Footer />
    <Analytics />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

      // Live local clock, shown in the header and footer
      const clocks = document.querySelectorAll<HTMLElement>("[data-clock]");
      const formatter = new Intl.DateTimeFormat("en-AU", {
        timeZone: "Australia/Adelaide",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: true,
      });
      const tick = () => {
        const time = formatter.format(new Date()).toUpperCase();
        clocks.forEach((el) => (el.textContent = time));
      };
      tick();
      setInterval(tick, 1000);
    </script>
  </body>
</html>
